<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
    <key>CFBundleDisplayName</key>
    <string>ChronosFlow</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <!-- Custom URL scheme so widget taps (chronosflow://today, …), the share extension's
         chronosflow://add-task hand-off, and Siri/Shortcuts deep links actually route into
         RootView.onOpenURL. Without this the system can't deliver the URL and every deep link
         is a silent no-op (the iOS analogue of Android's widget PendingIntents). -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>com.chronosflow.app.deeplink</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>chronosflow</string>
            </array>
        </dict>
    </array>
    <key>UILaunchScreen</key>
    <dict/>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <!-- Live Activities for the focus session (ActivityKit) -->
    <key>NSSupportsLiveActivities</key>
    <true/>
    <key>NSSupportsLiveActivitiesFrequentUpdates</key>
    <true/>
    <!-- HealthKit sleep import (iOS analogue of Android Health Connect) -->
    <key>NSHealthShareUsageDescription</key>
    <string>ChronosFlow reads your sleep data to show how you slept and adapt your day plan.</string>
    <!-- Face ID / Touch ID gate for the Medications tab (iOS analogue of the Android app-lock). -->
    <key>NSFaceIDUsageDescription</key>
    <string>ChronosFlow uses Face ID to keep your medications private.</string>
    <!-- Calendar overlay on the dial (EventKit; iOS 17+ uses the full-access key) -->
    <key>NSCalendarsUsageDescription</key>
    <string>ChronosFlow overlays your calendar events on the Chronos Dial.</string>
    <key>NSCalendarsFullAccessUsageDescription</key>
    <string>ChronosFlow overlays your calendar events on the Chronos Dial so you can plan around fixed commitments.</string>
    <!-- Journal photo attachments (PhotosPicker + in-app camera). -->
    <key>NSPhotoLibraryUsageDescription</key>
    <string>ChronosFlow lets you attach photos to journal entries to capture your day.</string>
    <key>NSCameraUsageDescription</key>
    <string>ChronosFlow lets you take a photo directly in the journal composer.</string>
    <!-- Voice dictation for journal entries (Speech + microphone). -->
    <key>NSSpeechRecognitionUsageDescription</key>
    <string>ChronosFlow transcribes your speech so you can dictate journal entries.</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>ChronosFlow uses the microphone to dictate journal entries.</string>
    <!-- Background scheduled auto-backup (BGTaskScheduler). -->
    <key>BGTaskSchedulerPermittedIdentifiers</key>
    <array>
        <string>com.chronosflow.autobackup</string>
        <string>com.chronosflow.interop.sync</string>
        <string>com.chronosflow.blocklive.refresh</string>
    </array>
    <key>UIBackgroundModes</key>
    <array>
        <string>fetch</string>
    </array>
</dict>
</plist>
