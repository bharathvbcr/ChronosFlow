<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" />

    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_chronosflow_tile"
        android:label="ChronosFlow"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault">

        <!-- Standalone Wear app: usable without a phone-side companion. -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Receives mirrored focus-session state from the phone via the Data Layer. -->
        <service
            android:name=".FocusWearListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/chronos/focus_session" />
            </intent-filter>
        </service>

        <!-- Receives the mirrored day summary (schedule, tasks, habits) for the tiles. -->
        <service
            android:name=".DaySummaryWearListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/chronos/day_summary" />
            </intent-filter>
        </service>

        <!-- Receives the phone's mirrored Material You palette for the app theme and tiles. -->
        <service
            android:name=".ThemeWearListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/chronos/theme" />
            </intent-filter>
        </service>

        <!-- "Now" glance: schedule + counts, or the live focus ring while a session runs. -->
        <service
            android:name=".ChronosTodayTileProvider"
            android:label="ChronosFlow Now"
            android:icon="@drawable/ic_chronosflow_tile"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
        </service>

        <service
            android:name=".ChronosHabitsTileProvider"
            android:label="ChronosFlow Habits"
            android:icon="@drawable/ic_chronosflow_tile"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
        </service>
    </application>

</manifest>
