<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" />

    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_chronosflow_tile"
        android:label="ChronosFlow"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault"
        android:dataExtractionRules="@xml/wear_data_extraction_rules">

        <!-- Standalone Wear app: usable without a phone-side companion. -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.DeviceDefault">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Receives mirrored focus-session state from the phone via the Data Layer. -->
        <service
            android:name=".FocusWearListenerService"
            android:exported="true"
            android:permission="com.google.android.permission.BIND_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/chronos/focus_session" />
            </intent-filter>
        </service>

        <!-- Receives the mirrored day summary (schedule, tasks, habits) for the tiles. -->
        <service
            android:name=".DaySummaryWearListenerService"
            android:exported="true"
            android:permission="com.google.android.permission.BIND_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/chronos/day_summary" />
            </intent-filter>
        </service>

        <!-- Receives the phone's mirrored Material You palette for the app theme and tiles. -->
        <service
            android:name=".ThemeWearListenerService"
            android:exported="true"
            android:permission="com.google.android.permission.BIND_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/chronos/theme" />
            </intent-filter>
        </service>

        <!-- "Now" glance: schedule + counts, or the live focus ring while a session runs. -->
        <service
            android:name=".ChronosTodayTileProvider"
            android:label="ChronosFlow Now"
            android:icon="@drawable/ic_chronosflow_tile"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
            <!-- Shown in the watch's tile picker so the tile is recognisable before it's added. -->
            <meta-data
                android:name="androidx.wear.tiles.PREVIEW"
                android:resource="@drawable/tile_preview_now" />
        </service>

        <service
            android:name=".ChronosHabitsTileProvider"
            android:label="ChronosFlow Habits"
            android:icon="@drawable/ic_chronosflow_tile"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
            <!-- Shown in the watch's tile picker so the tile is recognisable before it's added. -->
            <meta-data
                android:name="androidx.wear.tiles.PREVIEW"
                android:resource="@drawable/tile_preview_habits" />
        </service>

        <!-- Watch-face complication: the "Now" glance (current block / focus countdown / next-up)
             for any face slot that accepts short text, long text, or a ranged value. -->
        <service
            android:name=".ChronosNowComplicationService"
            android:label="ChronosFlow Now"
            android:icon="@drawable/ic_chronosflow_tile"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER"
            android:exported="true">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="SHORT_TEXT,LONG_TEXT,RANGED_VALUE" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="300" />
        </service>

        <!-- Habit-completion complication (progress arc / "3/5"). -->
        <service
            android:name=".ChronosHabitsComplicationService"
            android:label="ChronosFlow Habits"
            android:icon="@drawable/ic_chronosflow_tile"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER"
            android:exported="true">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="RANGED_VALUE,SHORT_TEXT,LONG_TEXT" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="900" />
        </service>

        <!-- Medication-due complication ("1 due" / all-taken). -->
        <service
            android:name=".ChronosMedsComplicationService"
            android:label="ChronosFlow Meds"
            android:icon="@drawable/ic_chronosflow_tile"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER"
            android:exported="true">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="SHORT_TEXT,LONG_TEXT,RANGED_VALUE" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="900" />
        </service>
    </application>

</manifest>
