<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Health Connect: read-only import of sleep sessions, including from a background WorkManager job. -->
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND" />
    <!-- Usage access: read per-app screen time (the data Digital Wellbeing is built on) for the
         focused-vs-distracted Insights. Special access the user grants in system settings. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <queries>
        <!-- Resolve the Health Connect provider so availability checks work on Android &lt; 14. -->
        <package android:name="com.google.android.apps.healthdata" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
    </queries>

    <application
        android:name=".ChronosApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="ChronosFlow"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:fullBackupContent="@xml/full_backup_content"
        android:theme="@style/Theme.ChronosFlow"
        android:enableOnBackInvokedCallback="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        tools:targetApi="33">

        <meta-data
            android:name="android.app.shortcuts"
            android:resource="@xml/shortcuts" />

        <property
            android:name="android.app.appfunctions.app_metadata"
            android:resource="@xml/app_metadata" />

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                tools:node="remove" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:resizeableActivity="true"
            android:theme="@style/Theme.ChronosFlow.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Receive text shared from another app (Chrome, Keep, Gmail, messaging, …) and
                 turn it into a new task via the capture sheet. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- Text-selection toolbar "ChronosFlow" action: capture selected text as a task. -->
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- "Open on phone" handoff from the Wear app (RemoteActivityHelper). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="chronosflow" android:host="open" />
            </intent-filter>
            <!-- Health Connect permission rationale: shown when the user reviews ChronosFlow's
                 sleep access. Android 13 and below dispatches the legacy action; 14+ uses the
                 platform permission-usage screen. -->
            <intent-filter>
                <action android:name="androidx.health.connect.action.SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".MainActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".core.ui.bubble.BubbleActivity"
            android:allowEmbedded="true"
            android:exported="false"
            android:label="Chronos Dial"
            android:resizeableActivity="true"
            android:theme="@style/Theme.ChronosFlow" />

        <service
            android:name="com.chronosflow.feature.focus.FocusService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Active focus session timer" />
        </service>

        <receiver
            android:name="com.chronosflow.core.notifications.AlarmReceiver"
            android:enabled="true"
            android:exported="false" />

        <receiver
            android:name="com.chronosflow.core.notifications.MedicationAlarmReceiver"
            android:enabled="true"
            android:exported="false" />

        <receiver
            android:name="com.chronosflow.core.notifications.MedicationActionReceiver"
            android:enabled="true"
            android:exported="false" />

        <receiver
            android:name="com.chronosflow.core.notifications.HabitActionReceiver"
            android:enabled="true"
            android:exported="false" />

        <receiver
            android:name="com.chronosflow.core.notifications.TaskActionReceiver"
            android:enabled="true"
            android:exported="false" />

        <receiver
            android:name="com.chronosflow.core.notifications.ReflowDayActionReceiver"
            android:enabled="true"
            android:exported="false" />

        <receiver
            android:name="com.chronosflow.core.notifications.ReminderGroupDeleteReceiver"
            android:enabled="true"
            android:exported="false" />

        <receiver
            android:name="com.chronosflow.core.notifications.CurrentBlockBoundaryReceiver"
            android:enabled="true"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <receiver
            android:name="com.chronosflow.core.notifications.ReminderBootReceiver"
            android:enabled="false"
            android:exported="false"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name="com.chronosflow.widget.ChronosGlanceWidgetReceiver"
            android:label="Focus"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/chronos_widget_info" />
        </receiver>

        <receiver
            android:name="com.chronosflow.widget.AgendaWidgetReceiver"
            android:label="Today's Schedule"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/chronos_agenda_widget_info" />
        </receiver>

        <receiver
            android:name="com.chronosflow.widget.TasksWidgetReceiver"
            android:label="Tasks"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/chronos_tasks_widget_info" />
        </receiver>

        <receiver
            android:name="com.chronosflow.widget.HabitsWidgetReceiver"
            android:label="Habits"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/chronos_habits_widget_info" />
        </receiver>

        <receiver
            android:name="com.chronosflow.widget.MedicationWidgetReceiver"
            android:label="Medication"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/chronos_medication_widget_info" />
        </receiver>

        <!-- Receives watch-originated actions (focus controls, habit/task/dose) over the
             Wearable MessageClient and replays them through the widget action use cases. -->
        <service
            android:name="com.chronosflow.widget.WearActionListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/chronos/action" />
            </intent-filter>
        </service>
    </application>

</manifest>
