<?xml version="1.0" encoding="utf-8"?>
<!--
    Cold-start launch window: an opaque cream fill (matched to Compose's first
    light surface so there is no flash while Compose warms) with the ChronosFlow
    dial mark centered on top — mirroring the Android 12+ system splash, which
    shows the same adaptive-icon foreground over the window background.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#F6F4EF" />
        </shape>
    </item>
    <item
        android:width="160dp"
        android:height="160dp"
        android:drawable="@drawable/ic_chronosflow_logo"
        android:gravity="center" />
</layer-list>
