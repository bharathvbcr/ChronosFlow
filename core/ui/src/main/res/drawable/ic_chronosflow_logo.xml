<!--
    ChronosFlow mark, mirroring the day dial: a dial ring with a teal progress
    arc and the dial's "now" hand — one continuous yellow hand from the center
    hub to its tip dot on the ring (with a soft glow), exactly like ChronosDial
    renders it. All geometry stays inside the adaptive-icon safe zone
    (radius ~33 of the 108dp viewport).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Track ring -->
    <path
        android:strokeColor="#6C63FF"
        android:strokeAlpha="0.35"
        android:strokeWidth="8"
        android:fillColor="#00000000"
        android:pathData="M54,28 A26,26 0 1 1 54,80 A26,26 0 1 1 54,28" />
    <!-- Progress arc: top, sweeping 210° clockwise -->
    <path
        android:strokeColor="#18B8A6"
        android:strokeWidth="8"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M54,28 A26,26 0 1 1 41,76.5" />
    <!-- Now hand: glow, hand, then tip halo + dot anchored on the ring -->
    <path
        android:strokeColor="#F7C948"
        android:strokeAlpha="0.3"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M54,54 L41,76.5" />
    <path
        android:strokeColor="#F7C948"
        android:strokeWidth="3.5"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M54,54 L41,76.5" />
    <path
        android:fillColor="#F7C948"
        android:fillAlpha="0.25"
        android:pathData="M33,76.5 a8,8 0 1 0 16,0 a8,8 0 1 0 -16,0 z" />
    <path
        android:fillColor="#F7C948"
        android:pathData="M36,76.5 a5,5 0 1 0 10,0 a5,5 0 1 0 -10,0 z" />
    <!-- Center hub, same color as the hand -->
    <path
        android:fillColor="#F7C948"
        android:pathData="M50,54 a4,4 0 1 0 8,0 a4,4 0 1 0 -8,0 z" />
</vector>
