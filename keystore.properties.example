# Release signing config for ChronosFlow (phone :app + watch :wear share ONE key so the
# Wearable Data Layer pairs them). Copy this file to `keystore.properties` (gitignored) and
# fill in real values to enable signed `release` builds. Without it, the build still works —
# the `release` variant is just left unsigned (and the `benchmark` variant stays debug-signed).
#
# Generate a keystore with:
#   keytool -genkeypair -v -keystore chronosflow-release.jks -alias chronosflow \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# storeFile is resolved relative to the repository root.
storeFile=chronosflow-release.jks
storePassword=your-store-password
keyAlias=chronosflow
keyPassword=your-key-password
